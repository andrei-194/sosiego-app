<?xml version="1.0" encoding="utf-8"?>
<!-- Respaldo en la nube y transferencia entre teléfonos (Android 12 o más). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/user.db"/>
        <include domain="sharedpref" path="."/>
        <exclude domain="root" path="app_flutter/content.db"/>
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/user.db"/>
        <include domain="sharedpref" path="."/>
        <exclude domain="root" path="app_flutter/content.db"/>
    </device-transfer>
</data-extraction-rules>
